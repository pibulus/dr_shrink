# DrShrink — server env (Passport checkout). Nothing here is needed for the
# app to shrink files; without it the Passport routes answer 503 politely.
#
# FLEET RULE: real values live in ~/.config/fleet/keys.env under
# DRSHRINK_EXTRA_ENV and reach the box via `keys-sync drshrink` →
# /etc/drshrink.env (systemd EnvironmentFile). Never hand-edit that file or
# an app-dir .env on the box — a deploy wipes the latter.

# ── Square ───────────────────────────────────────────────────────────────
# sandbox | production
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_ACCESS_TOKEN=
# ⚠ Fetch this from the token, don't copy it from the dashboard — the
# sandbox and production Location IDs differ and the wrong one throws
# INVALID_VALUE: curl -H "Authorization: Bearer $TOKEN" \
#   https://connect.squareupsandbox.com/v2/locations | jq '.locations[].id'
SQUARE_LOCATION_ID=
# From the webhook subscription in the Square developer dashboard.
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must match the subscription URL byte for byte (it is part of the HMAC).
SQUARE_WEBHOOK_NOTIFICATION_URL=https://drshrink.app/api/square/webhook

# ── Passport ─────────────────────────────────────────────────────────────
# ≥16 chars. Derives codes, passkeys and tokens — rotating it orphans every
# issued Passport, so set it once and back it up with the other keys.
PASSPORT_LICENSE_SECRET=
# Where checkouts/licenses persist (JSON files). Must be writable by the
# service user and survive deploys. Default ./data relative to the cwd.
DRSHRINK_DATA_DIR=/var/lib/drshrink
# memory | filesystem — memory is for tests only.
# DRSHRINK_STORE=filesystem

# Optional: unlock words that mint a personal Passport (friends, press).
# Comma-separated, case-insensitive. Capped by SUPPORTER_VOUCHER_LIMIT.
# SUPPORTER_UNLOCK_CODES=
# SUPPORTER_VOUCHER_LIMIT=25

# Optional: used in redirect URLs when behind a proxy that hides the origin.
PUBLIC_APP_URL=https://drshrink.app

# Optional: API rate limit per client per window (defaults 30 / 60000).
# API_RATE_LIMIT=30
# API_RATE_WINDOW_MS=60000
